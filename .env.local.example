# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Mapbox (used on /map and venue previews) ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# --- Resend (used by send-reminders Edge Function) ---
RESEND_API_KEY=re_your_resend_key
REMINDERS_FROM_EMAIL=reminders@quepasa.example

# --- Public site URL (used for OAuth redirects, ics links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
